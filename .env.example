# V-MIND FASHION Environment Variables

# Optional: Remote CDN / Cloudinary Video Hosting
# Provide your Cloudinary cloud name to automatically stream campaign videos from Cloudinary:
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Or provide a direct CDN base URL (e.g. AWS CloudFront, Cloudflare R2, Vercel Blob, etc.):
# NEXT_PUBLIC_MEDIA_URL=https://res.cloudinary.com/your_cloud_name/video/upload
